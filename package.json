    "viewsContainers": {
      "activitybar": [
        {
          "id": "httpme",
          "title": "http.me",
          "icon": "media/httpme.svg"
        }
      ],
      "panel": [
        {
          "id": "httpme-output",
          "title": "http.me",
          "icon": "media/httpme.svg"
        }
      ]
    },
    "views": {
      "httpme-output": [
        {
          "type": "webview",
          "id": "httpme.response",
          "name": "Response"
        }
      ],
      "httpme": [
        {
          "id": "httpme.sidebar",
          "name": "Collections"
        },
        {
          "id": "httpme.environments",
          "name": "Environments"
        },
        {
          "id": "httpme.open",
          "name": "Open"
        },
        {
          "id": "httpme.cookies",
          "name": "Cookies",
          "visibility": "collapsed"
        }
      ]
    },
    "keybindings": [
      {
        "command": "httpme.sendRequest",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourceExtname == .http"
      },
      {
        "command": "httpme.saveUntitled",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "resourceScheme == untitled && resourceExtname == .http"
      },
      {
        "command": "httpme.selectEnvironment",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      },
      {
        "command": "httpme.nextEnvironment",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]"
      },
      {
        "command": "httpme.previousEnvironment",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+["
      },
      {
        "command": "httpme.editActiveEnvironment",
        "key": "ctrl+alt+shift+e",
        "mac": "cmd+alt+shift+e"
      },
      {
        "command": "httpme.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == httpme.sidebar && !inputFocus"
      },
      {
        "command": "httpme.deleteSelectedEnvironment",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == httpme.environments && !inputFocus"
      },
      {
        "command": "httpme.deleteSelectedCookie",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == httpme.cookies && !inputFocus"
      }
    ],
    "viewsWelcome": [
      {
        "view": "httpme.sidebar",
        "contents": "Open a folder to store your collections.\n[Open Folder](command:vscode.openFolder)\n[New Request](command:httpme.newRequest)",
        "when": "workbenchState == empty"
      },
      {
        "view": "httpme.sidebar",
        "contents": "Loading http.me…",
        "when": "workbenchState != empty && !httpme.loaded.collections"
      },
      {
        "view": "httpme.sidebar",
        "contents": "Scanning the workspace for .http files…",
        "when": "workbenchState != empty && httpme.loaded.collections && httpme.scanning"
      },
      {
        "view": "httpme.sidebar",
        "contents": "No request matches the filter.\n[Clear Filter](command:httpme.clearFilter)",
        "when": "workbenchState != empty && httpme.loaded.collections && !httpme.scanning && httpme.collectionsFiltered"
      },
      {
        "view": "httpme.sidebar",
        "contents": "No .http files.\n[New Request](command:httpme.newRequest)\n[New Collection](command:httpme.newCollection)",
        "when": "workbenchState != empty && httpme.loaded.collections && !httpme.scanning && !httpme.collectionsFiltered"
      },
      {
        "view": "httpme.open",
        "contents": "Loading http.me…",
        "when": "workbenchState != empty && !httpme.loaded.open"
      },
      {
        "view": "httpme.environments",
        "contents": "Loading http.me…",
        "when": "workbenchState != empty && !httpme.loaded.environments"
      },
      {
        "view": "httpme.cookies",
        "contents": "Loading http.me…",
        "when": "workbenchState != empty && !httpme.loaded.cookies"
      },
      {
        "view": "httpme.open",
        "contents": "No open requests.\n[New Request](command:httpme.newRequest)",
        "when": "workbenchState != empty && httpme.loaded.open"
      }
    ],
    "configuration": {
      "title": "http.me",
      "properties": {
        "httpme.collectionsRoot": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Folder (relative to the workspace folder) where **New Collection** creates collections, for example `api`. Empty = the workspace folder."
        },
        "httpme.import.matchEnvironment": {
          "type": "string",
          "enum": [
            "always",
            "ask",
            "never"
          ],
          "default": "always",
          "enumDescriptions": [
            "Replace matching values with {{VARIABLE}} automatically (Undo in the notification).",
            "Ask before replacing.",
            "Never replace values."
          ],
          "markdownDescription": "When a cURL command is pasted or imported, replace values that equal an Environment or Globals value (URL prefix, query, headers, Bearer token, cookies, JSON / form body) with `{{VARIABLE}}`."
        },
        "httpme.login.autoRelogin": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When a response looks like an expired session (redirect to the login URL, or status 401 / 403), run the **Login request** of the active Environment once and resend the request. Never loops."
        },
        "httpme.login.expiredPattern": {
          "type": "string",
          "default": "/login",
          "markdownDescription": "Part of the URL that means \"login page\" (checked on redirects and the final URL) for **Auto re-login**."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "dev": "npm run compile && bash scripts/dev.sh",
    "test": "npm run compile && node --test out/test/src/*.test.js",
    "test:it": "npm run compile && node out/test/src/it/run.js",
    "package": "vsce package --skip-license",
    "install:local": "node scripts/install-local.js",
    "deploy": "bash scripts/deploy-v2.sh",
    "test:ui": "npm run compile && node test/ui/unfold.js && node test/ui/snippet.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
