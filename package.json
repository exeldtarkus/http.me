        {
          "command": "httpme.openInPanel",
          "when": "resourceExtname == .http && activeCustomEditorId != httpme.request",
          "group": "navigation"
        },
        {
          "command": "httpme.openAsText",
          "when": "activeCustomEditorId == httpme.request",
          "group": "navigation"
        },
        {
          "command": "httpme.openAsText",
          "when": "activeCustomEditorId == httpme.environment",
          "group": "navigation"
