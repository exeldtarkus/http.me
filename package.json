    "customEditors": [
      {
        "viewType": "httpme.request",
        "displayName": "http.me Request",
        "selector": [
          {
            "filenamePattern": "*.http"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "httpme.environment",
        "displayName": "http.me Environment",
        "selector": [
          {
            "filenamePattern": "**/.httpme/environments/*.json"
          },
          {
            "filenamePattern": "**/httpme-globals.json"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "http"
        ],
        "extensions": [
          ".http"
        ]
      }
    ],
    "grammars": [
      {
        "language": "http",
        "scopeName": "source.http",
        "path": "./syntaxes/http.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.json": "json",
          "meta.embedded.block.xml": "xml",
          "meta.embedded.block.javascript": "javascript"
        }
      },
      {
        "scopeName": "source.http.variables",
        "path": "./syntaxes/http.variables.tmLanguage.json",
        "injectTo": [
          "source.http"
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "httpme.backToDashboard",
          "when": "resourcePath in httpme.dashboardOpened || activeWebviewPanelId == 'httpme.compare'",
          "group": "navigation@0"
