{
  "name": "httpme",
  "displayName": "http.me",
  "description": "Lightweight HTTP client for VS Code: send requests from .http files, collections, environments and history, with a focus on low memory use.",
  "version": "0.0.1",
  "publisher": "exeltarkus",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "http",
    "rest",
    "api",
    "client",
    "postman",
    "curl"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/exeldtarkus/http.me.git"
  },
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "httpme.newRequest",
        "title": "New Request",
        "category": "http.me"
      },
      {
        "command": "httpme.sendRequest",
        "title": "Send Request",
        "category": "http.me"
      },
      {
        "command": "httpme.cancelRequest",
        "title": "Cancel Request",
        "category": "http.me"
      },
      {
        "command": "httpme.cancelAllRequests",
        "title": "Cancel All Requests",
        "category": "http.me"
      },
      {
        "command": "httpme.showRunning",
        "title": "Show Running Requests",
        "category": "http.me"
      },
      {
        "command": "httpme.whatsNew",
        "title": "What's New",
        "category": "http.me"
      },
      {
        "command": "httpme.clearCache",
        "title": "Clear Cache",
        "category": "http.me"
      }
    ],
    "customEditors": [
      {
        "viewType": "httpme.request",
        "displayName": "http.me Request",
        "selector": [
          {
            "filenamePattern": "*.http"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "dev": "npm run compile && bash scripts/dev.sh",
    "test": "npm run compile && node --test out/test/src/*.test.js",
    "test:it": "npm run compile && node out/test/src/it/run.js",
    "package": "vsce package --skip-license",
    "install:local": "node scripts/install-local.js",
    "deploy": "bash scripts/deploy-v2.sh"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
