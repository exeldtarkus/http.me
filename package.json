{
  "name": "httpme",
  "displayName": "http.me",
  "description": "Lightweight HTTP client for VS Code: send requests from .http files, collections, environments and history, with a focus on low memory use.",
  "version": "0.2.5",
  "publisher": "exeltarkus",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "http",
    "rest",
    "api",
    "client",
    "postman",
    "curl"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/exeldtarkus/http.me.git"
  },
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Pre-request and post-response scripts do not run in Restricted Mode."
    }
  },
