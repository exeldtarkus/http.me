{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HTTP",
  "scopeName": "source.http",
  "patterns": [
    {
      "include": "#separator"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#script-inline"
    },
    {
      "include": "#script-file"
    },
    {
      "include": "#file-variable"
    },
    {
      "include": "#curl-command"
    },
    {
      "include": "#request-line"
    },
    {
      "include": "#json-body"
    },
    {
      "include": "#xml-body"
    },
    {
      "include": "#header"
    },
    {
      "include": "#variable"
    }
  ],
  "repository": {
    "separator": {
      "match": "^###.*$",
      "name": "markup.heading.separator.http"
    },
    "comment": {
      "begin": "^\\s*(#|//)",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.comment.http"
        }
      },
      "name": "comment.line.http",
      "patterns": [
        {
          "match": "@[\\w-]+",
          "name": "keyword.other.directive.http"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "request-line": {
      "match": "^\\s*(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|QUERY|CONNECT|TRACE)\\s+(.+?)(?:\\s+(HTTP\\/[\\d.]+))?\\s*$",
      "captures": {
        "1": {
          "name": "keyword.control.method.http"
        },
        "2": {
          "name": "string.unquoted.uri.http",
          "patterns": [
            {
              "include": "#variable"
            }
          ]
        },
        "3": {
          "name": "constant.language.http-version.http"
        }
      }
    },
    "header": {
      "match": "^([\\w!#$%&'*+.^`|~-]+)(:)\\s*(.*)$",
      "captures": {
        "1": {
          "name": "entity.name.tag.header.http"
        },
        "2": {
          "name": "punctuation.separator.key-value.http"
        },
        "3": {
          "name": "string.unquoted.header-value.http",
          "patterns": [
            {
              "include": "#variable"
            }
          ]
        }
      }
    },
    "variable": {
      "match": "(\\{\\{)\\s*(?:(\\$[\\w.-]+)([^}]*?)|([^}]*?))\\s*(\\}\\})",
      "name": "meta.template.expression.http",
      "captures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.http"
        },
        "2": {
          "name": "support.function.dynamic.http"
        },
        "3": {
          "name": "variable.parameter.http"
        },
        "4": {
          "name": "variable.other.constant.http"
        },
        "5": {
          "name": "punctuation.definition.template-expression.end.http"
        }
      }
    },
    "json-body": {
      "begin": "^\\s*(?=[\\{\\[])",
      "end": "^(?=\\s*(?:###|[<>]\\s*\\{%|>\\s+\\S))",
      "contentName": "meta.embedded.block.json",
      "patterns": [
        {
          "include": "#variable"
        },
        {
          "include": "source.json"
        }
      ]
    },
    "xml-body": {
      "begin": "^\\s*(?=<[A-Za-z_?!])",
      "end": "^(?=\\s*(?:###|[<>]\\s*\\{%|>\\s+\\S))",
      "contentName": "meta.embedded.block.xml",
      "patterns": [
        {
          "include": "#variable"
        },
        {
          "include": "text.xml"
        }
      ]
    },
    "script-inline": {
      "begin": "^\\s*([<>])\\s*(\\{%)",
      "end": "(%\\})",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.script.http"
        },
        "2": {
          "name": "punctuation.section.embedded.begin.http"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.end.http"
        }
      },
      "contentName": "meta.embedded.block.javascript",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "script-file": {
      "match": "^\\s*([<>])\\s+(?!\\{%)(\\S.*?)\\s*$",
      "captures": {
        "1": {
          "name": "keyword.operator.script.http"
        },
        "2": {
          "name": "string.unquoted.path.http"
        }
      }
    },
    "file-variable": {
      "match": "^\\s*(@)([\\w.-]+)\\s*(=)\\s*(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.variable.http"
        },
        "2": {
          "name": "variable.other.declaration.http"
        },
        "3": {
          "name": "keyword.operator.assignment.http"
        },
        "4": {
          "name": "string.unquoted.value.http",
          "patterns": [
            {
              "include": "#variable"
            }
          ]
        }
      }
    },
    "curl-command": {
      "begin": "^\\s*(curl(?:\\.exe)?)(?=\\s|$)",
      "end": "(?<!\\\\)(?=\\n)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.curl.http"
        }
      },
      "patterns": [
        {
          "begin": "(?<=\\s)(--header|-H)(\\s+)(['\\\"])",
          "end": "\\3",
          "beginCaptures": {
            "1": {
              "name": "variable.parameter.option.header.curl.http"
            },
            "3": {
              "name": "punctuation.definition.string.begin.curl.http"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.curl.http"
            }
          },
          "contentName": "string.unquoted.header-value.http",
          "patterns": [
            {
              "match": "\\G\\s*([^:\\'\"]+?)\\s*(:)",
              "captures": {
                "1": {
                  "name": "entity.name.tag.header.http"
                },
                "2": {
                  "name": "punctuation.separator.key-value.http"
                }
              }
            },
            {
              "include": "#variable"
            }
          ]
        },
        {
          "begin": "(?<=\\s)(--data(?:-raw|-binary|-ascii|-urlencode)?|--json|-d)(\\s+)(')",
          "end": "\\3",
          "beginCaptures": {
            "1": {
              "name": "variable.parameter.option.data.curl.http"
            },
            "3": {
              "name": "punctuation.definition.string.begin.curl.http"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.curl.http"
            }
          },
          "contentName": "string.quoted.data.curl.http",
          "patterns": [
            {
              "include": "#variable"
            },
            {
              "include": "source.json"
            }
          ]
        },
        {
          "begin": "(?<=\\s)(--data(?:-raw|-binary|-ascii|-urlencode)?|--json|-d)(\\s+)(\")",
          "end": "\\3",
          "beginCaptures": {
            "1": {
              "name": "variable.parameter.option.data.curl.http"
            },
            "3": {
              "name": "punctuation.definition.string.begin.curl.http"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.curl.http"
            }
          },
          "contentName": "string.quoted.data.curl.http",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.curl.http"
            },
            {
              "include": "#variable"
            }
          ]
        },
        {
          "match": "(?<=\\s)(--url)(\\s+)(\\S+)",
          "captures": {
            "1": {
              "name": "variable.parameter.option.url.curl.http"
            },
            "3": {
              "name": "markup.underline.link.curl.http"
            }
          }
        },
        {
          "match": "(?<=\\s)--?[A-Za-z][\\w-]*",
          "name": "variable.parameter.option.curl.http"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.curl.http",
          "patterns": [
            {
              "include": "#variable"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.curl.http",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.curl.http"
            },
            {
              "include": "#variable"
            }
          ]
        },
        {
          "match": "\\\\$",
          "name": "punctuation.separator.continuation.curl.http"
        },
        {
          "include": "#variable"
        },
        {
          "match": "\\bhttps?://[^\\s\\'\"\\\\]+",
          "name": "markup.underline.link.curl.http"
        }
      ]
    }
  }
}
