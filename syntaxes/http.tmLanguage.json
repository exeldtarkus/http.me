{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HTTP",
  "scopeName": "source.http",
  "patterns": [
    { "include": "#separator" },
    { "include": "#comment" },
    { "include": "#request-line" },
    { "include": "#json-body" },
    { "include": "#xml-body" },
    { "include": "#header" },
    { "include": "#variable" }
  ],
  "repository": {
    "separator": {
      "match": "^###.*$",
      "name": "markup.heading.separator.http"
    },
    "comment": {
      "begin": "^\\s*(#|//)",
      "end": "$",
      "beginCaptures": { "1": { "name": "punctuation.definition.comment.http" } },
      "name": "comment.line.http",
      "patterns": [
        { "match": "@[\\w-]+", "name": "keyword.other.directive.http" },
        { "include": "#variable" }
      ]
    },
    "request-line": {
      "match": "^\\s*(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|QUERY|CONNECT|TRACE)\\s+(\\S+)(?:\\s+(HTTP\\/[\\d.]+))?\\s*$",
      "captures": {
        "1": { "name": "keyword.control.method.http" },
        "2": { "name": "string.unquoted.uri.http", "patterns": [{ "include": "#variable" }] },
        "3": { "name": "constant.language.http-version.http" }
      }
    },
    "header": {
      "match": "^([\\w!#$%&'*+.^`|~-]+)(:)\\s*(.*)$",
      "captures": {
        "1": { "name": "entity.name.tag.header.http" },
        "2": { "name": "punctuation.separator.key-value.http" },
        "3": { "name": "string.unquoted.header-value.http", "patterns": [{ "include": "#variable" }] }
      }
    },
    "variable": {
      "match": "\\{\\{\\s*[^}]*\\}\\}",
      "name": "variable.other.http"
    },
    "json-body": {
      "begin": "^\\s*(?=[\\{\\[])",
      "end": "^(?=###)",
      "contentName": "meta.embedded.block.json",
      "patterns": [
        { "include": "#variable" },
        { "include": "source.json" }
      ]
    },
    "xml-body": {
      "begin": "^\\s*(?=<)",
      "end": "^(?=###)",
      "contentName": "meta.embedded.block.xml",
      "patterns": [
        { "include": "#variable" },
        { "include": "text.xml" }
      ]
    }
  }
}
